# ─────────────────────────────────────────
# DealMind AI — Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────

# ── Hindsight Memory Server ──────────────
# URL of your running Hindsight instance
HINDSIGHT_BASE_URL=http://localhost:8888

# Optional: API key if you enabled Hindsight auth
# HINDSIGHT_API_KEY=

# ── LLM for the Sales Agent ──────────────
# Provider: openai | groq | anthropic | gemini
LLM_PROVIDER=groq
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=openai/gpt-oss-20b

# ── LLM used by Hindsight server itself ──
# (These go in the Hindsight server's own env, not here.
#  Listed for reference when running Hindsight locally.)
# HINDSIGHT_API_LLM_PROVIDER=groq
# HINDSIGHT_API_LLM_API_KEY=your_key
# HINDSIGHT_API_LLM_MODEL=openai/gpt-oss-20b

# ── Backend Server ────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── SQLite DB for deal/app data ───────────
DATABASE_URL=sqlite:///./dealmind.db

# ── CORS origins (comma-separated) ────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Logging ───────────────────────────────
LOG_LEVEL=INFO
